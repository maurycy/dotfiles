Include config.d/*

Host *
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent 1h
    ForwardAgent no
    HashKnownHosts yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
    # Enable connection sharing only in explicit host blocks in config.d.
    # ControlPath none also prevents reuse of an existing master.
    ControlMaster no
    ControlPath none
