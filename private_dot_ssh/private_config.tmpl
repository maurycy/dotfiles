Include config.d/*

Host *
    IdentitiesOnly yes
{{- if has .chezmoi.hostname (list "gimel" "bet") }}
    IdentityFile ~/.ssh/id_ecdsa_sk_rk_ssh-{{ .chezmoi.hostname }}
    SecurityKeyProvider /usr/lib/ssh-keychain.dylib
{{- else }}
    IdentityFile ~/.ssh/id_ed25519
{{- end }}
    AddKeysToAgent 1h
    ForwardAgent no
    HashKnownHosts yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ControlMaster no
    ControlPath none
