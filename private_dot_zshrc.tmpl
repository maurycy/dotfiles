# the first <Tab> bootstraps the deferred compinit, then acts as a normal Tab
_compinit_boot() {
  _compinit_real
  bindkey -M emacs '^I' _tab_or_diff_cycle
  zle _tab_or_diff_cycle
}
zle -N _compinit_boot

mupdate() {
  # nested, not global: only mupdate ever asked whether brew owns a tool,
  # and brew is not on PATH in non-interactive shells anyway. unfunction
  # at the bottom keeps the global namespace clean.
  _is_brew_pkg() {
    command -v brew >/dev/null && brew list "$1" &>/dev/null
  }
  # uv locks its cache with flock(2). util-linux flock(1) tests that exactly
  # on Linux; macOS has no flock(1) but always ships lsof. With neither,
  # report busy so the prune is skipped rather than risking a hang.
  _uv_cache_busy() {
    local lock="$(uv cache dir)/.lock"
    [[ -e "$lock" ]] || return 1
    if command -v flock >/dev/null; then
      ! flock -n -x "$lock" true
    elif command -v lsof >/dev/null; then
      lsof -t -- "$lock" >/dev/null 2>&1
    else
      return 0
    fi
  }

  # One GraphQL call compares every fork's default branch with its parent;
  # only forks that differ get a gh repo sync (which defaults to the parent),
  # eight at a time. Up-to-date forks cost nothing beyond the one query.
  command -v gh >/dev/null && gh auth status &>/dev/null && {
    gh api graphql -f query='query { viewer { repositories(first: 100, isFork: true, ownerAffiliations: OWNER) { nodes { nameWithOwner defaultBranchRef { target { oid } } parent { defaultBranchRef { target { oid } } } } } } }' \
      --jq '.data.viewer.repositories.nodes[] | select(.parent != null and .defaultBranchRef.target.oid != .parent.defaultBranchRef.target.oid) | .nameWithOwner' 2>/dev/null |
      xargs -P 8 -I{} sh -c 'gh repo sync "$1" >/dev/null 2>&1 && echo "synced $1" || echo "sync failed $1"' _ {}
  }

  command -v fastfetch >/dev/null && fastfetch
  command -v chezmoi >/dev/null && { chezmoi update || return; }
  command -v codex >/dev/null && command -v codex-purge >/dev/null && { codex-purge --apply || return; }
  # prune blocks on an exclusive lock while any long-lived uv/uvx process
  # holds the cache, and it is only housekeeping: skip it instead of hanging
  command -v uv >/dev/null && {
    { _is_brew_pkg uv || uv self update; } || return
    if _uv_cache_busy; then
      print -u2 "mupdate: uv cache in use, skipping prune"
    else
      uv cache prune || return
    fi
  }

  if whence -w backup >/dev/null 2>&1; then
    backup || return
  fi

  command -v gcloud >/dev/null && { gcloud components update || return; }

  if command -v brew >/dev/null; then
    brew update && brew upgrade -y --greedy && brew cleanup --scrub --prune=all || return
  fi

  if command -v apt >/dev/null; then
    sudo apt update && sudo apt -yu dist-upgrade || return
    sudo apt autoclean && sudo apt autoremove -y || return
    deborphan 2>/dev/null | xargs -r sudo apt-get remove -y --purge
    sudo aptitude purge '~c' 2>/dev/null
  fi

  # rebuild the curated CA bundle from the freshly updated ca-certificates
  command -v tls-ca-trim >/dev/null && { tls-ca-trim || return; }

  command -v rustup >/dev/null && { rustup update || return; }

  local cooldown_days=7
  command -v cargo-install-update >/dev/null && {
    cargo install-update -a --locked --cooldown "${cooldown_days}d" || return
  }
  # node itself: newest release of the same major, globals carried over
  command -v nvm >/dev/null && command -v node >/dev/null && {
    local node_cur
    node_cur=$(node --version) || return
    nvm install "${${node_cur#v}%%.*}" --reinstall-packages-from="$node_cur" --default || return
    [[ $(node --version) != "$node_cur" ]] && { nvm uninstall "$node_cur" || true; }
  }
  command -v npm >/dev/null && {
    zmodload zsh/datetime
    local before
    strftime -s before '%Y-%m-%d' $((EPOCHSECONDS - cooldown_days * 86400))
    npm update -g --before="$before" || return
  }

  command -v nvm >/dev/null && { nvm cache clear || true; }

  whence -w mupdate_local >/dev/null 2>&1 && { mupdate_local || true; }

  unfunction _is_brew_pkg _uv_cache_busy 2>/dev/null
}

