# shell options
setopt NO_BEEP
setopt EXTENDED_GLOB

# deduplicate PATH and fpath
typeset -U path fpath

# history: HISTFILE setup, 8-hour retention, secret-dropping zshaddhistory hook
{{ template "history.zsh" . }}

# Expire SQL history again after psql exits, including long-lived sessions.
if _is_safe_source "$HOME/.local/bin/psql-history"; then
  source "$HOME/.local/bin/psql-history"
  _psql_history_expire
  precmd_functions+=( _psql_history_expire )
  zshexit_functions+=( _psql_history_expire )
fi

# env
export EDITOR=vim
export DISABLE_SPRING=1
# npm never runs package install scripts (the main npm supply-chain vector).
# npm run/start/test still run their own script, only pre/post hooks and
# install-time scripts are skipped; allow a package case by case with
# --allow-scripts=<pkg>.
export NPM_CONFIG_IGNORE_SCRIPTS=true
{{- if eq .chezmoi.os "darwin" }}
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
export GPG_TTY=$TTY
# ssh-keygen, ssh-add and git's SSH signing talk to the Secure Enclave through
# Apple's library instead of looking for a USB FIDO key. YubiKey operations
# opt out with -w internal / -S internal.
export SSH_SK_PROVIDER=/usr/lib/ssh-keychain.dylib
# gcloud runs on Homebrew's python3 instead of its own bundled Python
# plus a venv under ~/.config/gcloud. Unversioned on purpose: a pin to
# python3.14 broke every Mac without that exact formula.
export CLOUDSDK_PYTHON=/opt/homebrew/bin/python3
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
{{ template "brew-env.zsh" . }}
{{- end }}

