# completion: compinit is deferred to the first <Tab> so it never touches the
# startup path. compdef calls made before then are queued here and replayed
# once compinit has run (see _compinit_boot, bound to ^I near the end).
typeset -ga _compdef_queue
compdef() { _compdef_queue+=( "${(j: :)${(q)@}}" ) }

_compinit_real() {
  emulate -L zsh
  unfunction compdef _compinit_real 2>/dev/null
  autoload -Uz compinit
  if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit
  else
    compinit -C
  fi
  zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
  zstyle ':completion:*:-command-:*' tag-order '!parameters'
  # gcloud completion needs compdef/bashcompinit, so it loads here too
  [[ -f "$HOME/.local/google-cloud-sdk/completion.zsh.inc" ]] && \
    source "$HOME/.local/google-cloud-sdk/completion.zsh.inc"
  local c
  for c in "${_compdef_queue[@]}"; do eval "compdef $c"; done
  unset _compdef_queue
}

autoload -U select-word-style
select-word-style bash

# prompt
autoload -Uz vcs_info
zstyle ':vcs_info:git:*' get-revision true
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr '+'
zstyle ':vcs_info:git:*' unstagedstr '*'
zstyle ':vcs_info:git*+set-message:*' hooks git-untracked
+vi-git-untracked() {
  if git rev-parse --is-inside-work-tree &>/dev/null && \
     [[ -n $(git ls-files --others --exclude-standard 2>/dev/null) ]]; then
    hook_com[unstaged]+='?'
  fi
}
zstyle ':vcs_info:git:*' formats '(%b %.7i%u%c)'
_set_prompt() {
  if (( ${COLUMNS:-80} < 120 )); then
    PS1="%(?..[%?] )%n@%B%m%b %1~ ${vcs_info_msg_0_} %# "
  else
    PS1="%(?..[%?] )%D{%Y-%m-%dT%H:%M:%S.%N%z} %n@%B%m%b %d ${vcs_info_msg_0_} %# "
  fi
}
precmd() {
  vcs_info
  _set_prompt
}
TRAPWINCH() {
  _set_prompt
  zle && zle reset-prompt
}

# path
[[ -d "$BUN_INSTALL/bin" ]] && path=("$BUN_INSTALL/bin" $path)

# tool initializations
# zoxide (cached; regenerated when the zoxide binary changes)
(( $+commands[zoxide] )) && _cache_eval zoxide "$commands[zoxide]" zoxide init zsh
# note: ~/.cargo/env is sourced once in .zshenv (runs before .zshrc)

# bun completion (sourced lazily from ~/.bun on first `bun` completion)
if [[ -r "$HOME/.bun/_bun" ]]; then
  _bun_load() { source "$HOME/.bun/_bun" }
  _lazy_load _bun_load _bun
  compdef _bun bun
fi

# uv completion: cached, parsed lazily on first `uv` completion - the ~500K
# completion script never touches the startup path
if (( $+commands[uv] )); then
  _uv_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/uv.zsh"
  _cache_file "$_uv_cache" "$commands[uv]" uv generate-shell-completion zsh
  if [[ -s "$_uv_cache" ]]; then
    _uv_load() { source "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/uv.zsh" }
    _lazy_load _uv_load _uv
    compdef _uv uv
  fi
  unset _uv_cache
fi

# google cloud sdk (completion.zsh.inc loads lazily inside _compinit_real)
[ -f "$HOME/.local/google-cloud-sdk/path.zsh.inc" ] && . "$HOME/.local/google-cloud-sdk/path.zsh.inc"

# functions
diff() {
  local args=() use_git=0
  for arg in "$@"; do
    if [[ "$arg" == --cach* ]]; then
      args+=(--cached)
      use_git=1
    else
      args+=("$arg")
    fi
  done
  if (( use_git )); then
    git diff "${args[@]}"
  else
    command diff "$@"
  fi
}

_diff() {
  _arguments \
    '--cached[show git staged changes]' \
    '*:file:_files'
}
compdef _diff diff

_tab_or_diff_cycle() {
  if [[ "$BUFFER" == "diff" ]]; then
    BUFFER="git diff"
    CURSOR=$#BUFFER
  elif [[ "$BUFFER" == "git diff" ]]; then
    BUFFER="diff"
    CURSOR=$#BUFFER
  else
    zle expand-or-complete
  fi
}
zle -N _tab_or_diff_cycle

# the first <Tab> bootstraps the deferred compinit, then acts as a normal Tab
_compinit_boot() {
  _compinit_real
  bindkey -M emacs '^I' _tab_or_diff_cycle
  zle _tab_or_diff_cycle
}
zle -N _compinit_boot

worktree() {
  case "$1" in
    ls) shift; git worktree list "$@" ;;
    rm) shift; git worktree remove "$@" ;;
    *)  git worktree "$@" ;;
  esac
}

_is_brew_pkg() {
  command -v brew >/dev/null && brew list "$1" &>/dev/null
}

mupdate() {
  command -v fastfetch >/dev/null && fastfetch
  command -v chezmoi >/dev/null && { chezmoi update || return; }
  command -v uv >/dev/null && { uv self update || return; }

  if whence -w backup >/dev/null 2>&1; then
    backup || return
  fi

  command -v gcloud >/dev/null && { gcloud components update || return; }

  if command -v brew >/dev/null; then
    brew update && brew upgrade && brew cleanup --scrub --prune=all || return
  fi

  if command -v apt >/dev/null; then
    sudo apt update && sudo apt -yu dist-upgrade || return
    sudo apt autoclean && sudo apt autoremove -y || return
    deborphan 2>/dev/null | xargs -r sudo apt-get remove -y --purge
    sudo aptitude purge '~c' 2>/dev/null
  fi

  command -v rustup >/dev/null && { rustup update || return; }

  command -v rbenv >/dev/null && ! _is_brew_pkg rbenv && { rbenv update || true; }
  command -v bun >/dev/null && ! _is_brew_pkg bun && { bun upgrade || true; }
  command -v nvm >/dev/null && { nvm cache clear || true; }

  command -v gh >/dev/null && gh auth status &>/dev/null && {
    gh repo list --fork --json nameWithOwner --jq '.[].nameWithOwner' | while read -r repo; do
      local parent
      parent=$(gh api "repos/${repo}" --jq '.parent.full_name' 2>/dev/null)
      if [[ -n "$parent" && "$parent" != "null" ]]; then
        echo "Syncing ${repo} <- ${parent}"
        gh repo sync "$repo" --source "$parent" || true
      fi
    done
  }

  whence -w mupdate_local >/dev/null 2>&1 && { mupdate_local || true; }
}

# rbenv (shims on PATH; `rbenv init` lazy-loaded on first `rbenv` call)
if command -v rbenv >/dev/null 2>&1 || [ -d "$HOME/.rbenv" ]; then
  export RBENV_ROOT="${RBENV_ROOT:-$HOME/.rbenv}"
  [[ -d "$RBENV_ROOT/bin" ]]   && path=("$RBENV_ROOT/bin" $path)
  [[ -d "$RBENV_ROOT/shims" ]] && path=("$RBENV_ROOT/shims" $path)
  _rbenv_load() { eval "$(rbenv init - zsh)" }
  _lazy_load _rbenv_load rbenv
fi

# nvm (lazy-loaded)
if [ -d "$NVM_DIR/versions/node" ]; then
  # resolver runs fork-free: $(<file) is read internally by zsh, and the
  # result is returned via REPLY so the caller avoids a $() subshell too.
  _nvm_resolve_alias() {
    local alias="$1" target
    while [ -f "$NVM_DIR/alias/$alias" ]; do
      target=$(<"$NVM_DIR/alias/$alias")
      [[ "$target" == v* ]] && { REPLY="$target"; return; }
      alias="$target"
    done
    if [ -f "$NVM_DIR/alias/lts/$alias" ]; then
      REPLY=$(<"$NVM_DIR/alias/lts/$alias")
    else
      REPLY="$alias"
    fi
  }
  _nvm_resolve_alias default
  NODE_VER="$REPLY"
  if [ -d "$NVM_DIR/versions/node/$NODE_VER" ]; then
    path=("$NVM_DIR/versions/node/$NODE_VER/bin" $path)
  else
    # newest installed version via glob: (/) dirs, (N) nullglob,
    # (On) numeric descending sort -> [1] is the latest
    _node_vers=( "$NVM_DIR"/versions/node/*(/Non) )
    (( $#_node_vers )) && path=("${_node_vers[1]}/bin" $path)
    unset _node_vers
  fi
  unset -f _nvm_resolve_alias
fi
if [ -s "$NVM_DIR/nvm.sh" ] || [ -s "/opt/homebrew/opt/nvm/nvm.sh" ]; then
  # node/npm/npx run as PATH binaries (pinned above); only `nvm` needs nvm.sh
  _nvm_load() {
    if [ -s "$NVM_DIR/nvm.sh" ]; then
      \. "$NVM_DIR/nvm.sh"
      [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    elif [ -s "/opt/homebrew/opt/nvm/nvm.sh" ]; then
      \. "/opt/homebrew/opt/nvm/nvm.sh"
    fi
    [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
  }
  _lazy_load _nvm_load nvm
fi

# xdg PATH first
path=("$HOME/.local/bin" $path)

# emacs mode (EDITOR=vim defaults to vi mode)
bindkey -e
# bind <Tab> after `bindkey -e` so it lands in the active emacs keymap
bindkey -M emacs '^I' _compinit_boot

# local overrides
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
[[ -f ~/.secrets ]] && source ~/.secrets
