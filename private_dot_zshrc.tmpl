# note: ~/.cargo/bin is added to PATH in .zshenv (runs before .zshrc)
# note: nvm/rbenv/uv/bun/gcloud load from the consolidated toolchain
# section further down (.chezmoitemplates/tools/).

# functions
diff() {
  local args=() use_git=0
  for arg in "$@"; do
    if [[ "$arg" == --cach* ]]; then
      args+=(--cached)
      use_git=1
    else
      args+=("$arg")
    fi
  done
  if (( use_git )); then
    git diff "${args[@]}"
  else
    command diff "$@"
  fi
}

_diff() {
  _arguments \
    '--cached[show git staged changes]' \
    '*:file:_files'
}
compdef _diff diff

_tab_or_diff_cycle() {
  if [[ "$BUFFER" == "diff" ]]; then
    BUFFER="git diff"
    CURSOR=$#BUFFER
  elif [[ "$BUFFER" == "git diff" ]]; then
    BUFFER="diff"
    CURSOR=$#BUFFER
  else
    zle expand-or-complete
  fi
}
zle -N _tab_or_diff_cycle

# the first <Tab> bootstraps the deferred compinit, then acts as a normal Tab
_compinit_boot() {
  _compinit_real
  bindkey -M emacs '^I' _tab_or_diff_cycle
  zle _tab_or_diff_cycle
}
zle -N _compinit_boot

worktree() {
  case "$1" in
    ls) shift; git worktree list "$@" ;;
    rm) shift; git worktree remove "$@" ;;
    *)  git worktree "$@" ;;
  esac
}

_is_brew_pkg() {
  command -v brew >/dev/null && brew list "$1" &>/dev/null
}

mupdate() {
  command -v fastfetch >/dev/null && fastfetch
  command -v chezmoi >/dev/null && { chezmoi update || return; }
  command -v uv >/dev/null && { uv self update || return; }

  if whence -w backup >/dev/null 2>&1; then
    backup || return
  fi

  command -v gcloud >/dev/null && { gcloud components update || return; }

  if command -v brew >/dev/null; then
    brew update && brew upgrade && brew cleanup --scrub --prune=all || return
  fi

  if command -v apt >/dev/null; then
    sudo apt update && sudo apt -yu dist-upgrade || return
    sudo apt autoclean && sudo apt autoremove -y || return
    deborphan 2>/dev/null | xargs -r sudo apt-get remove -y --purge
    sudo aptitude purge '~c' 2>/dev/null
  fi

  command -v rustup >/dev/null && { rustup update || return; }

  command -v rbenv >/dev/null && ! _is_brew_pkg rbenv && { rbenv update || true; }
  command -v bun >/dev/null && ! _is_brew_pkg bun && { bun upgrade || true; }
  command -v nvm >/dev/null && { nvm cache clear || true; }

  command -v gh >/dev/null && gh auth status &>/dev/null && {
    gh repo list --fork --json nameWithOwner --jq '.[].nameWithOwner' | while read -r repo; do
      local parent
      parent=$(gh api "repos/${repo}" --jq '.parent.full_name' 2>/dev/null)
      if [[ -n "$parent" && "$parent" != "null" ]]; then
        echo "Syncing ${repo} <- ${parent}"
        gh repo sync "$repo" --source "$parent" || true
      fi
    done
  }

  whence -w mupdate_local >/dev/null 2>&1 && { mupdate_local || true; }
}

