# /usr/local/bin/rsync -s -E -v -a -x --delete -l -u -H --exclude-from=$EXCLUDE -P -e ssh $SRC $DEST
if command -v rsync >/dev/null; then
{{- if eq .chezmoi.os "darwin" }}
  # macOS ships openrsync as /usr/bin/rsync (since Sequoia). openrsync lacks
  # -X/--xattrs, -A/--acls, -N/--crtimes, -s/--protect-args, --fileflags and
  # --force-change; Apple's -E (--extended-attributes) covers xattrs + resource
  # forks + ACLs, so -aE replaces -aAX. Linux keeps the full GPL-rsync flags.
  alias f-rsync='rsync -E -v -a -x --delete -l -u -H -P'
  alias my-rsync='rsync -avhzE'
  alias cc-rsync='rsync -v -E -H -go --numeric-ids -D -l -rtpx --ignore-errors'
{{- else }}
  alias f-rsync='rsync -s -E -v -a -x --delete -l -u -H -P'
  alias my-rsync='rsync -avhzrXANteEgoD --fileflags'
  alias cc-rsync='rsync -v -A -X -H -go --numeric-ids -D -l -rtpx -N --fileflags --force-change --protect-args --ignore-errors'
{{- end }}
fi

# completion: compinit is deferred to the first <Tab> so it never touches the
# startup path. compdef calls made before then are queued here and replayed
# once compinit has run (see _compinit_boot, bound to ^I near the end).
typeset -ga _compdef_queue _post_compinit_hooks
compdef() { _compdef_queue+=( "${(j: :)${(q)@}}" ) }

_compinit_real() {
  emulate -L zsh
  unfunction compdef _compinit_real 2>/dev/null
  autoload -Uz compinit
  # fast path (compinit -C) trusts the dump and skips the fpath audit, so
  # take it only if the dump is integrity-safe and fresh. _is_safe_source
  # also refuses a missing/symlinked/foreign/loose-perm file - in any of
  # those cases fall through to full compinit, which will rebuild it.
  if [[ -n ~/.zcompdump(#qN.mh+24) ]] || ! _is_safe_source ~/.zcompdump; then
    compinit
  else
    compinit -C
  fi
  zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
  zstyle ':completion:*:-command-:*' tag-order '!parameters'
  # drain deferred post-compinit hooks (e.g. gcloud completion, which
  # needs compdef/bashcompinit). tool snippets register function names
  # in _post_compinit_hooks; the $+functions guard turns a vanished hook
  # into a no-op rather than a "command not found" on the first <Tab>.
  local h
  for h in "${_post_compinit_hooks[@]}"; do
    (( $+functions[$h] )) && "$h"
  done
  unset -v _post_compinit_hooks
  local c
  for c in "${_compdef_queue[@]}"; do eval "compdef $c"; done
  unset _compdef_queue
}

