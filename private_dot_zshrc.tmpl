# --- language toolchains & SDKs ----------------------------------------
# each tool's full setup (env, PATH, lazy completion) lives in its own
# .chezmoitemplates/tools/ file. two ordering rules, both load-bearing:
#  - uv stays first. it reads $commands (the command hash); doing so
#    before gcloud/nvm prepend to PATH keeps the hash zoxide
#    already built valid. move it after a PATH prepend and the next
#    $commands access rebuilds the hash by rescanning all of PATH
#    (~2ms, measured) - the whole point of this consolidation was to
#    not regress startup.
#  - gcloud/nvm then prepend to PATH; the last prepend wins
#    the front, so ~/.local/bin (below) must stay after them all.
{{ template "tools/uv.zsh" . }}
{{ template "tools/gcloud.zsh" . }}
{{ template "tools/nvm.zsh" . }}

# xdg PATH first
_is_safe_dir "$HOME/.local/bin" && path=("$HOME/.local/bin" $path)

# emacs mode (EDITOR=vim defaults to vi mode)
bindkey -e
# bind <Tab> after `bindkey -e` so it lands in the active emacs keymap
bindkey -M emacs '^I' _compinit_boot

# local overrides
_is_safe_source "$HOME/.zshrc.local" && source "$HOME/.zshrc.local"
# ~/.secrets: source only if integrity-safe (not symlink/foreign/group-writable);
# integrity is guaranteed by the check above, so best-effort tighten perms to
# 0600 and source even if that chmod cannot make the file private
if _is_safe_source "$HOME/.secrets"; then
  chmod 600 "$HOME/.secrets" 2>/dev/null
  source "$HOME/.secrets"
fi
