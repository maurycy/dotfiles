# shared helpers - .zshenv is sourced first for every zsh, so .zprofile and
# .zshrc can both use these. The helper functions below only define
# themselves; they run nothing until called.

# Check every parent without following symlinks. Root-owned sticky directories
# permit private temporary homes under /private/tmp or /tmp on Linux.
_is_safe_parent() {
  emulate -L zsh
  zmodload -F zsh/stat b:zstat 2>/dev/null || return 1
  # Keep '..' until after each component check: lexical normalization could
  # hide a symlink before '..' even though the kernel follows that symlink.
  local d=$1
  [[ $d == /* ]] || d="$PWD/$d"
  d=${d:h}
  local -A s
  while true; do
    [[ -d $d && ! -L $d ]] || return 1
    zstat -H s -- "$d" 2>/dev/null || return 1
    (( s[uid] == EUID || s[uid] == 0 )) || return 1
    if (( s[mode] & 18 )); then
      (( s[uid] == 0 && (s[mode] & 512) )) || return 1
    fi
    [[ $d == / ]] && return 0
    d=${d:h}
  done
}

# _is_safe_source <file> [strict] - succeed only if <file> is a regular,
# non-symlink file owned by the current user. default: also require no
# group/other WRITE bit (tamper safety). `strict`: require no group/other
# permission bits at all - for cache files we create ourselves (mktemp 0600).
_is_safe_source() {
  emulate -L zsh
  zmodload -F zsh/stat b:zstat 2>/dev/null || return 1
  local f=$1
  [[ -f $f && ! -L $f && -O $f ]] || return 1
  _is_safe_parent "$f" || return 1
  local -A s
  zstat -H s -- "$f" 2>/dev/null || return 1
  # 18 = octal 022 (group/other write bits); 63 = octal 077 (all group/other
  # bits). plain decimals on purpose: zsh's 8#NN base notation would poison
  # the global integer output base and break `local -i` elsewhere (e.g.
  # vcs_info's max-exports), and a bare 0NN is read as decimal, not octal.
  if [[ -n $2 ]]; then
    (( (s[mode] & 63) == 0 )) || return 1
  else
    (( (s[mode] & 18) == 0 )) || return 1
  fi
  # source can select a newer compiled companion instead of the text file.
  if [[ -e $f.zwc || -L $f.zwc ]]; then
    [[ -f $f.zwc && ! -L $f.zwc && -O $f.zwc ]] || return 1
    zstat -H s -- "$f.zwc" 2>/dev/null || return 1
    (( (s[mode] & 63) == 0 )) || return 1
  fi
  return 0
}

# _is_safe_dir <path> - succeed only if <path> is a directory owned by the
# current user, not a symlink, with no group/other write bit. used to gate
# PATH prepends of home-resident directories (cargo, .local/bin, the per-tool
# bin/shim dirs). same threat model as _is_safe_source - catch the accident,
# not a hostile process - and CLAUDE.md notes that fpath and PATH are the
# same kind of surface, so the bar matches.
_is_safe_dir() {
  emulate -L zsh
  zmodload -F zsh/stat b:zstat 2>/dev/null || return 1
  local d=$1
  [[ -d $d && ! -L $d && -O $d ]] || return 1
  _is_safe_parent "$d" || return 1
  local -A s
  zstat -H s -- "$d" 2>/dev/null || return 1
  (( (s[mode] & 18) == 0 ))
}

# ensure <cache-path> holds the fresh stdout of <command>; regenerate it when
# the cache is missing/empty, <trigger> is newer, or the cache is not safe to
# source (symlink/foreign/loose perms). atomic write via mktemp.
# usage: _cache_file <cache-path> <trigger-path|''> <command> [args...]
_cache_file() {
  local cache="$1" trigger="$2" tmp
  local -a cmd=( "${@:3}" )
  if [[ ! -s "$cache" || ( -n "$trigger" && "$trigger" -nt "$cache" ) ]] \
     || ! _is_safe_source "$cache" strict; then
    mkdir -p "${cache:h}" || return 1
    _is_safe_dir "${cache:h}" || return 1
    chmod 700 "${cache:h}" || return 1
    if tmp=$(mktemp "${cache}.XXXXXX"); then
      if "${cmd[@]}" > "$tmp" && [[ -s "$tmp" ]]; then
        [[ ! -L $cache ]] || rm -f -- "$cache"
        if [[ -e $cache && ! -f $cache ]]; then
          rm -f -- "$tmp"
          return 1
        fi
        mv -f "$tmp" "$cache"
      else
        rm -f "$tmp"
      fi
    fi
  fi
}

# _cache_file under $XDG_CACHE_HOME/zsh/<name>.zsh, then source it - for
# shell-init snippets that must load on every startup.
# usage: _cache_eval <name> <trigger-path|''> <command> [args...]
_cache_eval() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/$1.zsh"
  _cache_file "$cache" "${@:2}"
  set --
  _is_safe_source "$cache" strict && source "$cache"
}

# define lazy stub commands that run <loader-fn> on first call, then re-dispatch.
# usage: _lazy_load <loader-fn> <cmd>...
_lazy_load() {
  emulate -L zsh
  local loader="$1" cmd quoted_loader quoted_cmds
  shift
  quoted_loader="${(q)loader}"
  quoted_cmds="${(q-)@}"
  for cmd in "$@"; do
    functions[$cmd]="
      unfunction -- $quoted_cmds 2>/dev/null
      $quoted_loader
      ${(q)cmd} \"\$@\"
    "
  done
}

# cargo: the env file only manipulates PATH - add the bin dir directly,
# avoiding a source of an external script in every (incl. non-interactive) zsh
_is_safe_dir "$HOME/.cargo/bin" && path=("$HOME/.cargo/bin" $path)

export SHELL_SESSIONS_DISABLE=1
export NODE_REPL_HISTORY=''
# 2026-10 eMudhra CA compromise (mozilla bug 2083449): use a maintained
# bundle for curl, git, Python and node, including non-interactive shells.
# The bundle itself still needs ca-certificates updates (see README).
_tls_ca_bundle=''
if [[ -r /opt/homebrew/etc/ca-certificates/cert.pem ]]; then
  _tls_ca_bundle=/opt/homebrew/etc/ca-certificates/cert.pem
elif [[ -r /etc/ssl/certs/ca-certificates.crt ]]; then
  _tls_ca_bundle=/etc/ssl/certs/ca-certificates.crt
fi
# Curated subset of that bundle, built by tls-ca-trim from
# ~/.config/tls/roots.txt: 11 roots cover every host in daily use (measured
# 2026-10-21), the other ~177 are attack surface only. It is data we read
# from $HOME, so it passes the same integrity gate as anything we source.
_tls_curated="${XDG_CONFIG_HOME:-$HOME/.config}/tls/ca-bundle.pem"
if [[ -s $_tls_curated ]] && _is_safe_source "$_tls_curated"; then
  _tls_ca_bundle="$_tls_curated"
fi
unset _tls_curated
if [[ -n $_tls_ca_bundle ]]; then
  export SSL_CERT_FILE="$_tls_ca_bundle"
  # An empty value disables the additional OpenSSL CA directory. Unsetting
  # it would restore the compiled-in directory and potentially old roots.
  export SSL_CERT_DIR=''
  export CURL_CA_BUNDLE="$_tls_ca_bundle"
  export GIT_SSL_CAINFO="$_tls_ca_bundle"
  export REQUESTS_CA_BUNDLE="$_tls_ca_bundle"
  # Replace inherited extra CAs too, so they cannot restore old roots.
  export NODE_EXTRA_CA_CERTS="$_tls_ca_bundle"
  # Temporary until node ships the distrust. SSL_CERT_FILE selects the
  # OpenSSL store explicitly, rather than assuming the nvm default is empty.
  if [[ " ${NODE_OPTIONS-} " != *" --use-openssl-ca "* ]]; then
    export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--use-openssl-ca"
  fi
fi
unset _tls_ca_bundle
[[ -x /opt/homebrew/opt/curl/bin/curl ]] && export HOMEBREW_FORCE_BREWED_CURL=1
export REDISCLI_HISTFILE=/dev/null
export PYTHON_HISTORY=/dev/null
