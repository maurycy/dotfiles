#!/bin/sh

# Compare directory contents, ignoring timestamps and permissions.
# Symbolic links are followed, as with diff. Exit status: 0 = identical,
# 1 = differences, 2 = error.

if [ "$#" -ne 2 ]; then
  printf 'Usage: %s <directory1> <directory2>\n' "$0" >&2
  exit 2
fi

for dir in "$@"; do
  if [ ! -d "$dir" ]; then
    printf "Error: '%s' is not a directory or does not exist.\n" "$dir" >&2
    exit 2
  fi
done

exec diff -qr -- "$1" "$2"
