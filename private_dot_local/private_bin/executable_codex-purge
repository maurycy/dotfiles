#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["websockets==17.3"]
# ///
"""Purge Codex sessions inactive for one calendar month through its local API.

The cutoff uses UTC. Requires uv. Starts the local Codex app-server when it is
not running, and stops it again afterwards.
Preview by default; --apply deletes expired persistent sessions.
Discovers sessions through the API and local rollout filenames.
Do not resume old sessions during cleanup: checking and deleting are separate
API requests. Sessions open in independent app-server processes are not visible.
"""

import argparse
import calendar
import itertools
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from uuid import UUID

from websockets.exceptions import WebSocketException
from websockets.sync.client import unix_connect


def month_ago(now):
    year, month = divmod(now.year * 12 + now.month - 2, 12)
    month += 1
    day = min(now.day, calendar.monthrange(year, month)[1])
    return now.replace(year=year, month=month, day=day).timestamp()


def rollout_ids():
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser()
    for directory in ("sessions", "archived_sessions"):
        for path in (home / directory).rglob("rollout-*.jsonl"):
            yield str(UUID(path.stem[-36:]))


def daemon(command):
    result = subprocess.run(
        ["codex", "app-server", "daemon", command],
        capture_output=True,
        text=True,
        timeout=60,
    )
    if result.returncode:
        raise RuntimeError(f"codex app-server daemon {command}: {result.stderr.strip()}")
    return json.loads(result.stdout)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="delete expired sessions")
    args = parser.parse_args()
    cutoff = month_ago(datetime.now(timezone.utc))
    info = daemon("start")
    if info["status"] not in ("started", "alreadyRunning"):
        raise RuntimeError(f"the local Codex server is {info['status']}")
    try:
        with unix_connect(
            info["socketPath"],
            open_timeout=10,
            close_timeout=5,
            max_size=8 * 1024 * 1024,
            legacy=True,
        ) as connection:
            purge(connection, cutoff, args.apply)
    finally:
        if info["status"] == "started":
            daemon("stop")


def purge(connection, cutoff, apply):
    ids = itertools.count()

    def send(message):
        connection.send(json.dumps(message))

    def rpc(method, **params):
        request_id = next(ids)
        deadline = time.monotonic() + 30
        send({"id": request_id, "method": method, "params": params})
        while True:
            try:
                reply = json.loads(
                    connection.recv(timeout=max(0, deadline - time.monotonic()))
                )
            except TimeoutError as error:
                raise TimeoutError(
                    f"{method}: Codex API did not respond within 30 seconds"
                ) from error
            if reply.get("id") == request_id:
                if "error" in reply:
                    raise RuntimeError(f"{method}: {reply['error']}")
                return reply["result"]

    def threads(**filters):
        result = []
        sources = [
            "cli",
            "vscode",
            "exec",
            "appServer",
            "subAgent",
            "subAgentReview",
            "subAgentCompact",
            "subAgentThreadSpawn",
            "subAgentOther",
            "unknown",
        ]
        for archived in (False, True):
            cursor = None
            while True:
                page = rpc(
                    "thread/list",
                    archived=archived,
                    cursor=cursor,
                    limit=100,
                    useStateDbOnly=True,
                    modelProviders=[],
                    sourceKinds=sources,
                    **filters,
                )
                result.extend(page["data"])
                cursor = page["nextCursor"]
                if cursor is None:
                    break
        return result

    def expired(thread):
        return (
            thread["updatedAt"] < cutoff
            and thread["status"]["type"] == "notLoaded"
            and not thread["ephemeral"]
        )

    rpc(
        "initialize",
        clientInfo={"name": "codex_purge", "version": "1"},
        capabilities={"experimentalApi": True},
    )
    send({"method": "initialized"})
    candidates = {t["id"]: t for t in threads()}
    # Ordinary API listings hide threads with empty previews and attached threads.
    # Read every additional rollout before deleting anything; an error aborts cleanup.
    for tid in sorted(set(rollout_ids()) - candidates.keys()):
        candidates[tid] = rpc("thread/read", threadId=tid)["thread"]
    handled = set()
    count = 0
    for thread in candidates.values():
        tid = thread["id"]
        if tid in handled or not expired(thread):
            continue
        current = rpc("thread/read", threadId=tid)["thread"]
        family = [current, *threads(ancestorThreadId=tid)]
        if not all(expired(t) for t in family):
            continue
        if apply:
            rpc("thread/delete", threadId=tid)
        selected = {t["id"] for t in family} - handled
        print(
            "deleted" if apply else "would delete",
            tid,
            f"({len(selected)} sessions)",
            flush=True,
        )
        count += len(selected)
        handled.update(selected)
    print(f"codex-purge: {count} sessions {'deleted' if apply else 'eligible'}")


if __name__ == "__main__":
    try:
        main()
    except (
        OSError,
        RuntimeError,
        ValueError,
        KeyError,
        TypeError,
        subprocess.SubprocessError,
        WebSocketException,
    ) as error:
        sys.exit(f"codex-purge: {error}")
