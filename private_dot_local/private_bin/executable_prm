#!/bin/bash
set -eu
umask 077

# Overwriting is best effort: SSDs, snapshots, and copy-on-write filesystems
# can retain earlier data. Never overwrite a symlink target or other hard link.
eraser=''
for candidate in shred gshred; do
  if command -v "$candidate" >/dev/null 2>&1; then
    eraser="$candidate"
    break
  fi
done
delete() {
  local file=$1 meta
  if [ -n "$eraser" ] && [ -f "$file" ] && [ ! -L "$file" ]; then
    meta=$(stat -c '%u %h' -- "$file" 2>/dev/null || stat -f '%u %l' "$file")
    if [ "$meta" = "$EUID 1" ]; then
      "$eraser" -n 1 -u -- "$file" && return
    fi
  fi
  rm -f -- "$file"
}

mode=remove
dry=0
targets=()

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      printf 'usage: prm [options] [file ...]\n'
      printf '\n'
      printf '  prm file [file ...]   delete files and all identical copies in .\n'
      printf '  prm --files-only     delete only the named paths; do not scan for copies\n'
      printf '  prm -d, --duplicates  find duplicate files in . and delete all but one copy\n'
      printf '  prm -n, --dry         show what would be deleted without deleting\n'
      printf '  prm -h, --help        show this help\n'
      printf '\nUses shred when available, without a secure-erasure guarantee.\n'
      exit 0
      ;;
    -d|--duplicates)
      mode=duplicates
      ;;
    -n|--dry)
      dry=1
      ;;
    --files-only)
      mode=files
      ;;
    --)
      shift
      targets+=( "$@" )
      break
      ;;
    -*)
      printf 'prm: unknown option: %s\n' "$1" >&2
      exit 1
      ;;
    *) targets+=( "$1" ) ;;
  esac
  shift
done

if [ "$mode" = files ]; then
  [ ${#targets[@]} -gt 0 ] || exit 0
  for target in "${targets[@]}"; do
    if [ "$dry" -eq 1 ]; then
      printf 'would del %s\n' "$target"
    else
      delete "$target"
    fi
  done
  exit 0
fi

seen=''
ref=''
cleanup() {
  [ -z "$seen" ] || delete "$seen"
  [ -z "$ref" ] || delete "$ref"
  return 0
}
trap cleanup EXIT

if [ "$mode" = duplicates ]; then
  seen=$(mktemp)
  : > "$seen"

  # oldest first: keep the oldest file, delete newer duplicates
  find . -type f -exec stat -f '%m	%N' {} + | sort -n | cut -f2- | while IFS= read -r file; do
    # skip if already deleted as a duplicate
    [ -f "$file" ] || continue

    file_size=$(wc -c < "$file")

    # check if we already processed an identical file
    while IFS= read -r seen_entry; do
      [ -n "$seen_entry" ] || continue
      seen_size="${seen_entry%%	*}"
      seen_path="${seen_entry#*	}"
      [ "$seen_size" -eq "$file_size" ] || continue
      [ -f "$seen_path" ] || continue
      if cmp -s "$seen_path" "$file"; then
        if [ "$dry" -eq 1 ]; then
          printf 'would del %s\n' "$file"
        else
          printf 'del %s\n' "$file"
          delete "$file"
        fi
        continue 2
      fi
    done < "$seen"

    printf '%s\t%s\n' "$file_size" "$file" >> "$seen"
  done

  delete "$seen"
  seen=''
  exit 0
fi

if [ ${#targets[@]} -eq 0 ]; then
  printf 'usage: prm [options] [file ...]\n' >&2
  exit 1
fi

for target in "${targets[@]}"; do
  if [ ! -f "$target" ] || [ -L "$target" ]; then
    printf 'prm: %s: not a regular file\n' "$target" >&2
    continue
  fi

  ref=$(mktemp)
  cp "$target" "$ref"
  target_size=$(wc -c < "$target")

  find . -type f -print0 | while IFS= read -r -d '' candidate; do
    [ -f "$candidate" ] || continue
    [ "$candidate" != "$ref" ] || continue
    candidate_size=$(wc -c < "$candidate")
    [ "$candidate_size" -eq "$target_size" ] || continue
    if cmp -s "$ref" "$candidate"; then
      if [ "$dry" -eq 1 ]; then
        printf 'would del %s\n' "$candidate"
      else
        printf 'del %s\n' "$candidate"
        delete "$candidate"
      fi
    fi
  done

  delete "$ref"
  ref=''
done
